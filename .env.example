# Application Environment
APP_ENV=development
APP_NAME="Japanese Speaking AI Training OS"
DEBUG=true

# API Server
API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Database & Cache
# For local Docker PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/speaking_training
# For lightweight local SQLite fallback: sqlite+aiosqlite:///./speaking_training.db
DATABASE_URL=sqlite+aiosqlite:///./speaking_training.db
DATABASE_SYNC_URL=sqlite:///./speaking_training.db
REDIS_URL=redis://localhost:6379/0

# Security (32-byte urlsafe base64 key for encrypting provider API keys at rest)
ENCRYPTION_KEY=dGhpc19pc19hXzMyX2J5dGVfZmZXcm5ldF9rZXkxMjM0NTY=

# Speech Engines (Phase 3)
VOICEVOX_ENGINE_URL=http://127.0.0.1:50021
VOICEVOX_ENGINE_PATH=E:\VoiceVox
WHISPER_DEFAULT_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
